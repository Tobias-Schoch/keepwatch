#!/usr/bin/env python3
"""keepwatch-log-archive: keeps the logs of every Docker container for 14 days (configurable),
even across re-creation (redeploys, image updates, auto-updaters).

Why: Docker deletes a container's json log file as soon as the container is removed.
This service follows exactly those files (like `tail -F`) and writes every line into
daily files that the container does not own:

    /var/log/keepwatch/containers/<stack>/<container>/YYYY-MM-DD.log       (today, UTC)
    /var/log/keepwatch/containers/<stack>/<container>/YYYY-MM-DD.log.gz    (older days)

Line:   2026-10-23T20:24:50.038903730Z out|err <text>
        2026-10-23T20:24:49.000000000Z meta {"event":"created","reason":"…",…}

No log loss on re-creation: we keep the file open. If Docker deletes it (container
removed) or rotates it (max-size), we read to the end through the open file descriptor
and only then close it. The Docker event stream reports new containers immediately
(create/start); in addition we reconcile every 60 s.

No duplicate writes: per container we remember the file (inode) and position in
/var/lib/keepwatch/log-archive/state.json – saved only after the lines are in the
archive. After a restart we continue exactly there; if that is not enough (file rotated
in the meantime, crash between writing and saving), the timestamp of the last archived
line filters out what is already there.

No changes to Docker: daemon.json stays as it is, no restart, no other log driver.
Containers with a driver other than json-file are skipped (noted in the status).

Space: settings in /etc/keepwatch/log-archive.conf (DAYS, MAX_MB_PER_CONTAINER,
MAX_MB_TOTAL), re-read every minute. Above a limit the oldest days go first; if that is
not enough, the service drops new lines of that container for the rest of the day and
records that. Both show up in status.json for the dashboard.

    keepwatch-log-archive             service (systemd: keepwatch-log-archive.service)
    keepwatch-log-archive --dry-run   reads everything once, writes nothing, shows what it would do

Standard library only. Runs as root (reads /var/lib/docker/containers).
"""
from __future__ import annotations

import calendar
import datetime as dt
import gzip
import http.client
import json
import os
import queue
import re
import shutil
import signal
import socket
import sys
import threading
import time
import urllib.parse
from pathlib import Path

ROOT = Path(os.environ.get("KW_LOG_ARCHIVE_DIR", "/var/log/keepwatch/containers"))
STATE_DIR = Path(os.environ.get("KW_LOG_ARCHIVE_STATE", "/var/lib/keepwatch/log-archive"))
CONF = Path(os.environ.get("KW_LOG_ARCHIVE_CONF", "/etc/keepwatch/log-archive.conf"))
SOCK = os.environ.get("DOCKER_SOCK", "/var/run/docker.sock")

DEFAULTS = {"DAYS": 14, "MAX_MB_PER_CONTAINER": 300, "MAX_MB_TOTAL": 2000}
BOUNDS = {"DAYS": (1, 90), "MAX_MB_PER_CONTAINER": (10, 50_000), "MAX_MB_TOTAL": (50, 200_000)}
POLL = 1.0               # seconds between two looks into the log files
RECONCILE = 60.0         # reconcile with `docker ps -a`, re-read settings, write status
MAINTAIN = 3600.0        # compress and clean up (additionally at the day change)
MAX_LINE = 16_384        # characters per line in the archive
CHUNK = 4 << 20          # bytes per read() (the first catch-up can be tens of MB per container)
EVENTS = ["create", "start", "restart", "die", "oom", "destroy"]

STAMP = re.compile(r"^(\d{4})-(\d\d)-(\d\d)T(\d\d):(\d\d):(\d\d)(?:\.(\d{1,9}))?(Z|[+-]\d\d:\d\d)$")
SAFE = re.compile(r"[^A-Za-z0-9_.-]+")
TMPNAME = re.compile(r"^[0-9a-f]{12}_")   # Compose renames the old container like this while re-creating
DAYFILE = re.compile(r"^(\d{4}-\d\d-\d\d)\.log(\.gz)?$")

DRY = "--dry-run" in sys.argv


def log(msg: str):
    print(msg, file=sys.stderr if DRY else sys.stdout, flush=True)


# --------------------------------------------------------------------------- Time

def parse_ns(s: str) -> int | None:
    m = STAMP.match(s)
    if not m:
        return None
    y, mo, d, h, mi, se = (int(x) for x in m.groups()[:6])
    sec = calendar.timegm((y, mo, d, h, mi, se, 0, 0, 0))
    tz = m.group(8)
    if tz != "Z":
        sign = 1 if tz[0] == "+" else -1
        sec -= sign * (int(tz[1:3]) * 3600 + int(tz[4:6]) * 60)
    return sec * 1_000_000_000 + int((m.group(7) or "").ljust(9, "0"))


def fmt_ns(ns: int) -> str:
    sec, frac = divmod(ns, 1_000_000_000)
    return time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(sec)) + f".{frac:09d}Z"


def day_of(ns: int) -> str:
    return time.strftime("%Y-%m-%d", time.gmtime(ns // 1_000_000_000))


def today() -> str:
    return time.strftime("%Y-%m-%d", time.gmtime())


def day_minus(day: str, n: int) -> str:
    return (dt.date.fromisoformat(day) - dt.timedelta(days=n)).isoformat()


# --------------------------------------------------------------------------- Settings

def read_conf() -> dict:
    conf = dict(DEFAULTS)
    try:
        for line in CONF.read_text().splitlines():
            k, sep, v = line.partition("=")
            k, v = k.strip(), v.split("#", 1)[0].strip().strip('"')
            if sep and k in DEFAULTS:
                try:
                    lo, hi = BOUNDS[k]
                    conf[k] = max(lo, min(hi, int(v)))
                except ValueError:
                    pass
    except OSError:
        pass
    return conf


# --------------------------------------------------------------------------- Docker API (Unix socket)

class _Conn(http.client.HTTPConnection):
    def __init__(self, timeout: float | None):
        super().__init__("docker", timeout=timeout)

    def connect(self):
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(self.timeout)
        s.connect(SOCK)
        self.sock = s


def docker(path: str, timeout: float = 15):
    c = _Conn(timeout)
    try:
        c.request("GET", path)
        r = c.getresponse()
        body = r.read()
    finally:
        c.close()
    if r.status == 404:
        return None
    if r.status >= 400:
        raise OSError(f"Docker API {path}: {r.status} {body[:200]!r}")
    return json.loads(body)


def events_loop(q: queue.Queue, stop: threading.Event):
    """Docker events (containers only) into the queue. After every (re)connect a
    reconcile; with `since`, Docker replays what happened during the gap."""
    since: int | None = None
    flt = urllib.parse.quote(json.dumps({"type": ["container"], "event": EVENTS}))
    quiet = False
    while not stop.is_set():
        try:
            c = _Conn(None)
            c.request("GET", f"/events?filters={flt}" + (f"&since={since}" if since else ""))
            r = c.getresponse()
            if r.status != 200:
                raise OSError(f"/events: {r.status}")
            q.put(("reconcile", None))
            if quiet:
                log("Docker events: reconnected")
            quiet = False
            while not stop.is_set():
                line = r.readline()
                if not line:
                    break
                try:
                    ev = json.loads(line)
                except ValueError:
                    continue
                since = int(ev.get("time") or 0) or since
                q.put(("event", ev))
        except Exception as e:  # noqa: BLE001 – Docker gone/restarted: keep trying
            if not quiet:
                log(f"Docker events: {e} – retrying every 3 s")
                quiet = True
        stop.wait(3)


# --------------------------------------------------------------------------- Writing the archive

def key_dir(key: str) -> Path:
    return ROOT / key


def day_files(d: Path) -> list[tuple[str, Path]]:
    out = []
    try:
        for p in d.iterdir():
            m = DAYFILE.match(p.name)
            if m:
                out.append((m.group(1), p))
    except OSError:
        pass
    return sorted(out)


class Writer:
    """Writes lines into the daily file (day = the line's timestamp, UTC) and enforces the limits."""

    def __init__(self, conf: dict):
        self.conf = conf
        self.open: dict[tuple[str, str], object] = {}
        self.today = today()
        self.size: dict[str, int] = {}        # bytes per container on disk (all days)
        self.today_size: dict[str, int] = {}  # of which today
        self.dropped: dict[str, int] = {}     # dropped today (limit)
        self.trimmed: dict[str, str] = {}     # container → up to which day deleted early
        self.full_note: set[str] = set()
        self.lines = 0
        self.last_maint = 0.0
        self.scan()

    def scan(self):
        self.size.clear()
        self.today_size.clear()
        if not ROOT.is_dir():
            return
        for stack in ROOT.iterdir():
            if not stack.is_dir():
                continue
            for cont in stack.iterdir():
                if not cont.is_dir():
                    continue
                key = f"{stack.name}/{cont.name}"
                for day, p in day_files(cont):
                    try:
                        n = p.stat().st_size
                    except OSError:
                        continue
                    self.size[key] = self.size.get(key, 0) + n
                    if day == self.today:
                        self.today_size[key] = self.today_size.get(key, 0) + n

    def total(self) -> int:
        return sum(self.size.values())

    def oldest_day(self) -> str:
        return day_minus(today(), self.conf["DAYS"])

    def _handle(self, key: str, day: str):
        h = self.open.get((key, day))
        if h:
            return h
        d = key_dir(key)
        d.mkdir(parents=True, exist_ok=True)
        plain, gz = d / f"{day}.log", d / f"{day}.log.gz"
        if day != self.today and gz.exists() and not plain.exists():
            h = gzip.open(gz, "ab", compresslevel=6)  # late lines for an already compressed day: new gzip member
        else:
            h = open(plain, "ab", buffering=256 * 1024)
        self.open[(key, day)] = h
        return h

    def add(self, key: str, ns: int, kind: str, text: str) -> bool:
        day = day_of(ns)
        if day < self.oldest_day():
            return False
        if len(text) > MAX_LINE:
            text = text[:MAX_LINE] + " …[truncated]"
        data = f"{fmt_ns(ns)} {kind} {text}\n".encode("utf-8", "replace")
        if kind != "meta":
            cap_c = self.conf["MAX_MB_PER_CONTAINER"] * 1_000_000
            cap_t = self.conf["MAX_MB_TOTAL"] * 1_000_000
            over = self.today_size.get(key, 0) + len(data) > cap_c
            if not over and self.total() + len(data) > cap_t:
                if time.monotonic() - self.last_maint > 60:
                    self.maintain(reason="total limit")
                over = self.total() + len(data) > cap_t
            if over:
                self.dropped[key] = self.dropped.get(key, 0) + 1
                if key not in self.full_note:
                    self.full_note.add(key)
                    self.add(key, ns, "meta", json.dumps({"event": "limit", "reason": "space limit reached – further lines from today are dropped"}, ensure_ascii=False))
                return False
        if DRY:
            self.lines += 1
            self.size[key] = self.size.get(key, 0) + len(data)
            return True
        self._handle(key, day).write(data)
        self.lines += 1
        self.size[key] = self.size.get(key, 0) + len(data)
        if day == self.today:
            self.today_size[key] = self.today_size.get(key, 0) + len(data)
        return True

    def flush(self):
        for (key, day), h in list(self.open.items()):
            h.flush()
            if day != self.today:      # only today's file stays open
                h.close()
                del self.open[(key, day)]

    def close(self):
        for h in self.open.values():
            try:
                h.close()
            except OSError:
                pass
        self.open.clear()

    def day_changed(self) -> bool:
        t = today()
        if t == self.today:
            return False
        self.flush()
        self.close()
        self.today = t
        self.today_size.clear()
        self.dropped.clear()
        self.full_note.clear()
        return True

    # ---- Compress and clean up ----------------------------------------------------------------
    def maintain(self, reason: str = ""):
        self.last_maint = time.monotonic()
        if DRY or not ROOT.is_dir():
            return
        self.flush()
        t, oldest = self.today, self.oldest_day()
        files: list[tuple[str, str, Path]] = []  # (day, container, file)
        for stack in list(ROOT.iterdir()):
            if not stack.is_dir():
                continue
            for cont in list(stack.iterdir()):
                if not cont.is_dir():
                    continue
                key = f"{stack.name}/{cont.name}"
                for day, p in day_files(cont):
                    if day < oldest:
                        p.unlink(missing_ok=True)
                        continue
                    if day < t and p.suffix == ".log" and (key, day) not in self.open:
                        p = self._pack(p)
                    files.append((day, key, p))
                for leftover in cont.glob("*.tmp"):
                    leftover.unlink(missing_ok=True)
                try:
                    cont.rmdir()  # only if empty
                except OSError:
                    pass
            try:
                stack.rmdir()
            except OSError:
                pass
        self.scan()
        # Per-container limit: oldest days first, never today.
        cap_c = self.conf["MAX_MB_PER_CONTAINER"] * 1_000_000
        cap_t = self.conf["MAX_MB_TOTAL"] * 1_000_000
        files.sort()
        for day, key, p in list(files):
            if day < t and self.size.get(key, 0) > cap_c:
                self._drop(day, key, p, files)
        for day, key, p in list(files):
            if self.total() <= cap_t:
                break
            if day < t:
                self._drop(day, key, p, files)

    def _drop(self, day: str, key: str, p: Path, files: list):
        try:
            n = p.stat().st_size
            p.unlink()
        except OSError:
            return
        files.remove((day, key, p))
        self.size[key] = max(0, self.size.get(key, 0) - n)
        if self.trimmed.get(key, "") < day:
            self.trimmed[key] = day
        log(f"space limit: {key} {day} deleted early")

    @staticmethod
    def _pack(p: Path) -> Path:
        gz = p.with_name(p.name + ".gz")
        tmp = p.with_name(p.name + ".gz.tmp")
        try:
            with open(p, "rb") as src, gzip.open(tmp, "wb", compresslevel=6) as dst:
                shutil.copyfileobj(src, dst, 1 << 20)
            if gz.exists():  # a compressed part already exists: append (gzip allows multiple members)
                with open(gz, "ab") as out, open(tmp, "rb") as part:
                    shutil.copyfileobj(part, out, 1 << 20)
                tmp.unlink()
            else:
                os.replace(tmp, gz)
            p.unlink()
            return gz
        except OSError as e:
            log(f"compressing {p} failed: {e}")
            tmp.unlink(missing_ok=True)
            return p


# --------------------------------------------------------------------------- Reading containers

class Track:
    """One container instance: keeps its json log file open and reads what is new."""

    def __init__(self, arch: "Archive", cid: str, key: str, path: str):
        self.arch, self.id, self.key, self.path = arch, cid, key, path
        self.f = None
        self.ino = 0
        self.pos = 0
        self.buf = b""
        self.partial = {"out": "", "err": ""}
        self.partial_ns = {"out": 0, "err": 0}
        self.last_ns = 0
        self.skip_until = 0
        self.gone = False

    # ---- Start: continue where we left off ----------------------------------------------------
    def start(self, saved: dict | None, archived_ns: int):
        chain = self._chain()
        if not chain:
            raise FileNotFoundError(self.path)
        idx = None
        saved = saved or ({"ino": -1, "pos": 0, "lastNs": 0} if archived_ns else None)
        if saved:
            self.last_ns = int(saved.get("lastNs") or 0)
            for i, p in enumerate(chain):
                try:
                    if os.stat(p).st_ino == saved.get("ino"):
                        idx = i
                        break
                except OSError:
                    pass
        if idx is None:
            # File rotated in the meantime (or state lost): read everything that is still
            # there; the timestamp filters out what is already in the archive.
            self.skip_until = max(archived_ns, self.last_ns)
            for p in chain[:-1]:
                self._read_whole(p, 0)
            self._open(chain[-1], 0)
        else:
            # Continue exactly at the saved position. If the archive already holds more (crash
            # between writing and saving), skip up to that point.
            self.skip_until = archived_ns if archived_ns > self.last_ns else 0
            for j, p in enumerate(chain[idx:-1]):
                self._read_whole(p, int(saved["pos"]) if j == 0 else 0)
            self._open(chain[-1], int(saved["pos"]) if idx == len(chain) - 1 else 0)

    def _chain(self) -> list[str]:
        """Oldest first: <log>.2, <log>.1, <log>"""
        rot = []
        n = 1
        while os.path.exists(f"{self.path}.{n}"):
            rot.append(f"{self.path}.{n}")
            n += 1
        out = list(reversed(rot))
        if os.path.exists(self.path):
            out.append(self.path)
        return out

    def _open(self, p: str, pos: int):
        self.f = open(p, "rb")
        st = os.fstat(self.f.fileno())
        self.ino = st.st_ino
        if pos > st.st_size:
            pos = 0
        self.f.seek(pos)
        self.pos = pos
        self.buf = b""
        self.poll_file()

    def _read_whole(self, p: str, pos: int):
        try:
            with open(p, "rb") as f:
                f.seek(pos)
                rest = b""
                while True:
                    chunk = f.read(CHUNK)
                    if not chunk:
                        break
                    rest = self._lines(rest + chunk)
        except OSError:
            pass

    # ---- Ongoing ------------------------------------------------------------------------------
    def poll_file(self) -> bool:
        if not self.f:
            return False
        got = False
        while True:
            chunk = self.f.read(CHUNK)
            if not chunk:
                break
            got = True
            data = self.buf + chunk
            self.buf = self._lines(data)
            self.pos += len(data) - len(self.buf)   # pos = end of the last complete line
        return got

    def poll(self) -> bool:
        """Read what is new; if rotated or deleted: finish reading the old file, then the new one."""
        got = self.poll_file()
        try:
            st = os.stat(self.path)
        except FileNotFoundError:
            st = None
        if st is not None and st.st_ino == self.ino:
            return got
        got = self.poll_file() or got
        self.f.close()
        self.f = None
        if st is None:
            self._flush_partial()
            self.gone = True     # container removed (or file gone) – everything read
            return got
        self._open(self.path, 0)
        return True

    def close(self):
        if self.f:
            self.poll_file()
            self.f.close()
            self.f = None
        self._flush_partial()

    # ---- Lines --------------------------------------------------------------------------------
    def _lines(self, data: bytes) -> bytes:
        *done, rest = data.split(b"\n")
        for raw in done:
            self._entry(raw)
        return rest

    def _entry(self, raw: bytes):
        try:
            e = json.loads(raw)
            text, stream, stamp = e["log"], e.get("stream", "stdout"), e["time"]
        except (ValueError, KeyError, TypeError):
            return
        ns = parse_ns(stamp)
        if ns is None:
            return
        kind = "err" if stream == "stderr" else "out"
        if not text.endswith("\n"):
            # Docker splits lines longer than 16 KB; the parts arrive without \n.
            if not self.partial[kind]:
                self.partial_ns[kind] = ns
            if len(self.partial[kind]) < MAX_LINE * 2:
                self.partial[kind] += text
            return
        if self.partial[kind]:
            text, ns = self.partial[kind] + text, self.partial_ns[kind]
            self.partial[kind] = ""
        self._emit(ns, kind, text[:-1].rstrip("\r"))

    def _flush_partial(self):
        for kind in ("out", "err"):
            if self.partial[kind]:
                self._emit(self.partial_ns[kind], kind, self.partial[kind])
                self.partial[kind] = ""

    def _emit(self, ns: int, kind: str, text: str):
        if self.skip_until and ns <= self.skip_until:
            return
        self.skip_until = 0
        if self.arch.writer.add(self.key, ns, kind, text):
            self.arch.dirty = True
        if ns > self.last_ns:
            self.last_ns = ns


# --------------------------------------------------------------------------- Main loop

class Archive:
    def __init__(self):
        self.conf = read_conf()
        self.conf_mtime = self._conf_mtime()
        self.writer = Writer(self.conf)
        self.tracks: dict[str, Track] = {}
        self.skipped: dict[str, str] = {}       # containers without json-file → reason
        self.dirty = False
        self.started_ns = time.time_ns()
        self.fresh = False   # no state found (first start or lost)
        self.state = self._load_state()
        self.q: queue.Queue = queue.Queue()
        self.stop = threading.Event()

    # ---- State --------------------------------------------------------------------------------
    def _load_state(self) -> dict:
        try:
            st = json.loads((STATE_DIR / "state.json").read_text())
            if isinstance(st, dict):
                st.setdefault("tracks", {})
                st.setdefault("keys", {})
                return st
        except (OSError, ValueError):
            pass
        self.fresh = True
        return {"tracks": {}, "keys": {}, "since": time.time()}

    def save_state(self):
        for cid, t in self.tracks.items():
            self.state["tracks"][cid] = {"key": t.key, "ino": t.ino, "pos": t.pos, "lastNs": t.last_ns}
        if DRY:
            return
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        tmp = STATE_DIR / "state.json.tmp"
        tmp.write_text(json.dumps(self.state, ensure_ascii=False))
        os.replace(tmp, STATE_DIR / "state.json")

    def write_status(self):
        if DRY:
            return
        keys = self.state["keys"]
        conts = {}
        for key, size in sorted(self.writer.size.items()):
            days = [d for d, _ in day_files(key_dir(key))]
            k = keys.get(key, {})
            conts[key] = {"bytes": size, "today": self.writer.today_size.get(key, 0), "days": len(days),
                          "from": days[0] if days else None, "to": days[-1] if days else None,
                          "dropped": self.writer.dropped.get(key, 0), "trimmed": self.writer.trimmed.get(key),
                          "id": (k.get("id") or "")[:12], "image": k.get("image"), "active": any(t.key == key for t in self.tracks.values())}
        notes = []
        for key, n in self.writer.dropped.items():
            notes.append(f"{key}: {n} lines dropped today – per-container limit ({self.conf['MAX_MB_PER_CONTAINER']} MB) reached")
        for key, day in self.writer.trimmed.items():
            notes.append(f"{key}: days up to {day} deleted early (space limit)")
        total = self.writer.total()
        if total > 0.9 * self.conf["MAX_MB_TOTAL"] * 1_000_000:
            notes.append(f"archive almost full: {total / 1e6:.0f} of {self.conf['MAX_MB_TOTAL']} MB")
        st = {"v": 1, "at": time.time(), "since": self.state.get("since"), "pid": os.getpid(),
              "days": self.conf["DAYS"], "maxPerContainerMb": self.conf["MAX_MB_PER_CONTAINER"],
              "maxTotalMb": self.conf["MAX_MB_TOTAL"], "bytes": total, "containers": conts,
              "unarchived": self.skipped, "notes": notes}
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        tmp = STATE_DIR / "status.json.tmp"
        tmp.write_text(json.dumps(st, ensure_ascii=False))
        os.replace(tmp, STATE_DIR / "status.json")

    def _conf_mtime(self) -> float:
        try:
            return CONF.stat().st_mtime
        except OSError:
            return 0.0

    def reload_conf(self):
        m = self._conf_mtime()
        if m != self.conf_mtime:
            self.conf_mtime = m
            self.conf.clear()
            self.conf.update(read_conf())
            log(f"settings: {self.conf}")
            self.writer.maintain("settings")

    # ---- Containers ---------------------------------------------------------------------------
    @staticmethod
    def key_for(info: dict) -> str:
        labels = (info.get("Config") or {}).get("Labels") or {}
        stack = labels.get("com.docker.compose.project") or "no-stack"
        name = TMPNAME.sub("", (info.get("Name") or "").lstrip("/")) or info["Id"][:12]
        return f"{SAFE.sub('_', stack)[:64]}/{SAFE.sub('_', name)[:128]}"

    def archived_last_ns(self, key: str) -> int:
        """Timestamp of the last line in the archive (only uncompressed today/yesterday – enough for the crash gap)."""
        best = 0
        for day, p in reversed(day_files(key_dir(key))):
            if p.suffix != ".log":
                break
            try:
                with open(p, "rb") as f:
                    f.seek(max(0, f.seek(0, 2) - 65536))
                    for raw in f.read().split(b"\n"):
                        stamp, _, rest = raw.partition(b" ")
                        if rest[:4] in (b"out ", b"err "):
                            ns = parse_ns(stamp.decode("ascii", "replace"))
                            if ns and ns > best:
                                best = ns
            except OSError:
                pass
            if best:
                break
        return best

    def adopt(self, cid: str, live: bool):
        """Pick up a (new) container: open its log file, record a change of instance."""
        if cid in self.tracks:
            return
        info = docker(f"/containers/{cid}/json")
        if not info:
            return
        name = info.get("Name", "").lstrip("/")
        lc = (info.get("HostConfig") or {}).get("LogConfig") or {}
        if lc.get("Type") != "json-file":
            self.skipped[name] = f"log driver {lc.get('Type') or '?'} – not archived"
            return
        path = info.get("LogPath") or ""
        if not path or not os.path.exists(path):
            return  # never started yet: arrives with the start event
        saved = self.state["tracks"].get(cid)
        key = saved["key"] if saved else self.key_for(info)
        created = parse_ns(info.get("Created", "")) or time.time_ns()
        cur = {"id": cid, "image": (info.get("Config") or {}).get("Image"), "imageId": info.get("Image"),
               "cfg": ((info.get("Config") or {}).get("Labels") or {}).get("com.docker.compose.config-hash"),
               "created": created}
        prev = self.state["keys"].get(key)
        if prev and prev.get("id") != cid and created >= int(prev.get("created") or 0):
            reason = self.reason(prev, cur, offline=created < self.started_ns and not live)
            self.writer.add(key, created, "meta", json.dumps(
                {"event": "created", "id": cid[:12], "previous": (prev.get("id") or "")[:12], "image": cur["image"], "reason": reason},
                ensure_ascii=False))
            self.dirty = True
        if not prev or created >= int(prev.get("created") or 0):
            keep = {k: prev[k] for k in ("exit",) if prev and prev.get("id") == cid and k in prev}
            self.state["keys"][key] = {**cur, **keep}
        t = Track(self, cid, key, path)
        try:
            # No saved position, but an archive exists (state lost): write nothing twice.
            t.start(saved, self.archived_last_ns(key) if saved or self.fresh else 0)
        except OSError as e:
            log(f"{name}: log file not readable: {e}")
            return
        self.tracks[cid] = t
        self.skipped.pop(name, None)
        if not saved:
            log(f"tracking: {key} ({cid[:12]})")

    @staticmethod
    def reason(prev: dict, cur: dict, offline: bool) -> str:
        parts = []
        if prev.get("imageId") and cur.get("imageId") and prev["imageId"] != cur["imageId"]:
            if prev.get("image") and prev.get("image") != cur.get("image"):
                parts.append(f"different image: {prev['image']} → {cur['image']}")
            else:
                parts.append(f"update: new image for {cur.get('image')}")
        elif prev.get("cfg") and cur.get("cfg") and prev["cfg"] != cur["cfg"]:
            parts.append("configuration changed, redeployed")
        else:
            parts.append("redeployed, same image")
        ex = prev.get("exit") or {}
        if ex.get("oom"):
            parts.append("previously out of memory (OOM)")
        elif ex.get("code") not in (None, 0) and cur["created"] - int(ex.get("at") or 0) > 60 * 1_000_000_000:
            parts.append(f"previously crashed (code {ex['code']})")
        if offline:
            parts.append("while the archive was not running – logs of the old container are missing")
        return " · ".join(parts)

    def on_event(self, ev: dict):
        action = (ev.get("Action") or ev.get("status") or "").split(":")[0]
        cid = (ev.get("Actor") or {}).get("ID") or ev.get("id") or ""
        attrs = (ev.get("Actor") or {}).get("Attributes") or {}
        ns = int(ev.get("timeNano") or 0) or time.time_ns()
        if not cid:
            return
        t = self.tracks.get(cid)
        key = t.key if t else next((k for k, v in self.state["keys"].items() if v.get("id") == cid), None)
        if action in ("create", "start", "restart"):
            if t and action == "start":
                ex = (self.state["keys"].get(t.key) or {}).get("exit")
                if ex and ex.get("at", 0) and ex.get("id") == cid and not ex.get("restarted"):
                    ex["restarted"] = True
                    reason = "out of memory (OOM)" if ex.get("oom") else f"exited with code {ex.get('code')}"
                    self.writer.add(t.key, ns, "meta", json.dumps({"event": "restarted", "id": cid[:12], "reason": reason}, ensure_ascii=False))
                    self.dirty = True
            if not t:
                try:
                    self.adopt(cid, live=True)
                except OSError as e:
                    log(f"{attrs.get('name', cid[:12])}: {e}")
        elif action == "oom" and key:
            k = self.state["keys"].get(key) or {}
            if k.get("id") == cid:
                k["exit"] = {**(k.get("exit") or {}), "oom": True, "id": cid, "at": ns}
        elif action == "die" and key:
            if t:
                t.poll()  # fetch what the container wrote last, right away
            k = self.state["keys"].get(key) or {}
            try:
                code = int(attrs.get("exitCode", ""))
            except ValueError:
                code = None
            oom = bool((k.get("exit") or {}).get("oom")) and (k.get("exit") or {}).get("id") == cid
            if k.get("id") == cid:
                k["exit"] = {"code": code, "oom": oom, "id": cid, "at": ns}
            self.writer.add(key, ns, "meta", json.dumps(
                {"event": "exited", "id": cid[:12], "code": code, "reason": "out of memory (OOM)" if oom else f"exited with code {code}"},
                ensure_ascii=False))
            self.dirty = True
        elif action == "destroy":
            if t:
                t.close()  # finish reading the open file – Docker has just deleted it
                del self.tracks[cid]
                self.state["tracks"].pop(cid, None)
            if key and (self.state["keys"].get(key) or {}).get("id") == cid:
                self.writer.add(key, ns, "meta", json.dumps({"event": "removed", "id": cid[:12], "reason": "container removed"}, ensure_ascii=False))
            self.dirty = True

    def reconcile(self):
        try:
            conts = docker("/containers/json?all=1") or []
        except OSError as e:
            log(f"Docker not reachable: {e}")
            return
        conts.sort(key=lambda c: c.get("Created", 0))
        ids = {c["Id"] for c in conts}
        for c in conts:
            if c["Id"] not in self.tracks:
                try:
                    self.adopt(c["Id"], live=False)
                except OSError as e:
                    log(f"{c.get('Names')}: {e}")
        for cid in [i for i in self.tracks if i not in ids]:
            self.tracks.pop(cid).close()
            self.state["tracks"].pop(cid, None)
            self.dirty = True
        # saved positions of containers that no longer exist
        for cid in [i for i in self.state["tracks"] if i not in ids]:
            del self.state["tracks"][cid]
        # keep instance knowledge only as long as the archive itself
        cutoff = (time.time() - (self.conf["DAYS"] + 1) * 86400) * 1e9
        for key in [k for k, v in self.state["keys"].items() if int(v.get("created") or 0) < cutoff and v.get("id") not in ids]:
            del self.state["keys"][key]

    def poll_all(self):
        for cid, t in list(self.tracks.items()):
            try:
                if t.poll():
                    self.dirty = True
            except OSError as e:
                log(f"{t.key}: {e}")
            if t.gone:
                del self.tracks[cid]
                self.state["tracks"].pop(cid, None)
                self.dirty = True

    def commit(self):
        if self.dirty:
            self.writer.flush()
            self.save_state()
            self.dirty = False

    def run(self):
        if not DRY:
            ROOT.mkdir(parents=True, exist_ok=True, mode=0o750)
        signal.signal(signal.SIGTERM, lambda *_: self.stop.set())
        signal.signal(signal.SIGINT, lambda *_: self.stop.set())
        threading.Thread(target=events_loop, args=(self.q, self.stop), daemon=True, name="events").start()
        self.writer.maintain("start")
        self.reconcile()
        self.commit()
        self.write_status()
        log(f"running: {len(self.tracks)} containers, archive {ROOT}, {self.conf['DAYS']} days")
        next_poll = next_rec = time.monotonic()
        next_maint = time.monotonic() + MAINTAIN
        while not self.stop.is_set():
            wait = next_poll - time.monotonic()
            if wait > 0:
                try:
                    kind, ev = self.q.get(timeout=wait)
                except queue.Empty:
                    pass
                else:
                    try:
                        self.on_event(ev) if kind == "event" else self.reconcile()
                    except Exception as e:  # noqa: BLE001 – one broken event must not stop the archive
                        log(f"event {ev and ev.get('Action')}: {e!r}")
                    continue
            next_poll = time.monotonic() + POLL
            try:
                self.poll_all()
                now = time.monotonic()
                if self.writer.day_changed() or now >= next_maint:
                    self.writer.maintain("day change")
                    next_maint = now + MAINTAIN
                    self.write_status()
                if now >= next_rec:
                    next_rec = now + RECONCILE
                    self.reload_conf()
                    self.reconcile()
                    self.commit()
                    self.write_status()
                self.commit()
            except OSError as e:  # disk full or similar: report, try again shortly
                log(f"error: {e!r}")
                time.sleep(5)
        # clean shutdown: read everything, write it, save the position
        self.poll_all()
        for t in self.tracks.values():
            t._flush_partial()
        self.commit()
        self.writer.close()
        self.write_status()
        log("stopped")


def dry_run():
    a = Archive()
    a.writer.maintain()
    per: dict[str, int] = {}
    orig = a.writer.add

    def counting(key, ns, kind, text):
        if orig(key, ns, kind, text):
            per[f"{key} {day_of(ns)} {kind}"] = per.get(f"{key} {day_of(ns)} {kind}", 0) + 1
            if kind == "meta":
                print(f"  meta {key} {fmt_ns(ns)} {text}")
            return True
        return False

    a.writer.add = counting
    a.reconcile()
    for k in sorted(per):
        print(f"{per[k]:8d}  {k}")
    print(f"{a.writer.lines} lines, {a.writer.total() / 1e6:.1f} MB uncompressed, {len(a.tracks)} containers, skipped: {a.skipped or '-'}")
    for t in a.tracks.values():
        t.f and t.f.close()


if __name__ == "__main__":
    if DRY:
        dry_run()
    else:
        Archive().run()
