#!/bin/sh
# Keepwatch login banner (replaces Ubuntu's help texts and ads).
KW_DASHBOARD_PORT=9004
[ -r /etc/keepwatch/keepwatch.conf ] && . /etc/keepwatch/keepwatch.conf 2>/dev/null
TS=$(tailscale status --json 2>/dev/null | jq -r '.Self.DNSName // empty' 2>/dev/null | sed 's/\.$//')
if grep -q '^SSH_PUBLIC=no' /etc/keepwatch/firewall.env 2>/dev/null; then
  P="closed to the internet - Tailscale only"
elif [ -f /etc/keepwatch/firewall.env ]; then
  P="open to the internet (keys only)"
else
  P="not managed by Keepwatch"
fi
printf '\n  %s  ·  %s\n' "$(hostname)" "$(hostname -I | awk '{print $1}')"
[ -n "$TS" ] && printf '  Tailscale   %s\n' "$TS"
if systemctl is-active -q keepwatch-dashboard 2>/dev/null; then
  printf '  Dashboard   127.0.0.1:%s  (on your computer: ./keepwatch tunnel)\n' "$KW_DASHBOARD_PORT"
fi
printf '  SSH         %s\n  Keepwatch   /opt/keepwatch  (change keepwatch.conf on your computer, then ./keepwatch deploy)\n\n' "$P"
