# Keepwatch: /etc/fail2ban/jail.d/keepwatch-tailscale.local (only with the tailscale module).
# SSH over Tailscale (100.64.0.0/10): the same limit as from the internet
# (KW_F2B_SSH_MAXRETRY, dashboard: Settings -> fail2ban) - never stricter,
# your own devices live here. The sshd jail ignores the tailnet.
[sshd-tailscale]
enabled       = true
filter        = sshd[mode=aggressive]
backend       = systemd
journalmatch  = _SYSTEMD_UNIT=ssh.service + _COMM=sshd + _COMM=sshd-session
port          = @SSH_PORT@
maxretry      = @SSH_MAXRETRY@
findtime      = 24h
bantime       = @SSH_BANTIME@
ignorecommand = /usr/local/sbin/keepwatch-f2b-not-tailscale <ip>
