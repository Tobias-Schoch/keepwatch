# /etc/keepwatch/backup/env (mode 600) - written once by the backup module,
# then changed by the dashboard (Settings -> Backup) or by hand.
# Sourced by keepwatch-backup: shell syntax, every variable is exported, so
# provider credentials for restic (AWS_ACCESS_KEY_ID, B2_ACCOUNT_ID, ...) go here too.

# Password of the restic repositories. Without this file EVERY backup is
# unreadable - keep a copy in your password manager.
RESTIC_PASSWORD_FILE=/etc/keepwatch/backup/restic.pass

LOCAL_REPO=/var/backups/keepwatch/restic

# Retention (dashboard -> Settings -> Backup). Locally short is enough -
# restores mostly want the newest snapshot.
KEEP_DAILY=@KEEP_DAILY@
KEEP_WEEKLY=@KEEP_WEEKLY@
KEEP_MONTHLY=@KEEP_MONTHLY@
# Off-site: per level at least as much as locally, or `restic copy` copies
# back every night what the off-site prune just removed.
REMOTE_KEEP_DAILY=@REMOTE_KEEP_DAILY@
REMOTE_KEEP_WEEKLY=@REMOTE_KEEP_WEEKLY@
REMOTE_KEEP_MONTHLY=@REMOTE_KEEP_MONTHLY@

# Off-site restic repository (KW_BACKUP_REMOTE). Empty = local backups only.
# REMOTE_NAME is the label shown in logs and the dashboard; REMOTE_ENV_KEYS
# lists the names of the credential variables below.
REMOTE_REPO=
REMOTE_NAME=
REMOTE_ENV_KEYS=
RCLONE_CONFIG=/etc/keepwatch/backup/rclone.conf

# Provider credentials (asked for during deploy, depending on REMOTE_REPO):
