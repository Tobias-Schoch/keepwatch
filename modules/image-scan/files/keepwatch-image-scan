#!/usr/bin/env python3
"""Keepwatch image scan: the images of all running containers, checked with Trivy
for known vulnerabilities (HIGH and CRITICAL).

Runs as keepwatch-image-scan.service (weekly timer, KW_IMAGE_SCAN_TIME, or "Scan now"
in the dashboard). Trivy runs as a container (pinned version), its database lives in
the volume trivy-cache. Result: /var/lib/keepwatch/image-scan.json (read by the
dashboard), during a run the progress in image-scan.progress.json.

The scan changes nothing about running services: it only pulls the Trivy image and
its database and reads the images through the Docker socket.
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
import time
from pathlib import Path

TRIVY = "aquasec/trivy:0.75.0"
CACHE = "trivy-cache"
STATE = Path("/var/lib/keepwatch")
OUT = STATE / "image-scan.json"
PROGRESS = STATE / "image-scan.progress.json"
# 2 GB are enough for Trivy even with large images (the proxy image is ~2 GB), and keep a
# small server responsive while it scans.
LIMITS = ["--memory", "2g", "--memory-swap", "2g", "--cpus", "1.5"]
MAX_VULNS = 200  # per image, keeps the file small


def write(path: Path, data: dict):
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False))
    os.chmod(tmp, 0o644)
    tmp.replace(path)


def trivy(*args: str, timeout: int = 1800) -> subprocess.CompletedProcess:
    return subprocess.run(["docker", "run", "--rm", *LIMITS, "-v", f"{CACHE}:/root/.cache/",
                           "-v", "/var/run/docker.sock:/var/run/docker.sock", TRIVY, *args],
                          capture_output=True, text=True, timeout=timeout)


def main() -> int:
    started = time.time()
    lines = subprocess.run(["docker", "ps", "--format", "{{.Image}}\t{{.Names}}"], capture_output=True, text=True,
                           check=True).stdout.splitlines()
    images: dict[str, list[str]] = {}
    for line in lines:
        ref, _, name = line.partition("\t")
        images.setdefault(ref, []).append(name)
    result = {"startedAt": started, "finishedAt": None, "ok": False, "error": None, "trivy": TRIVY, "images": {}}

    def progress(current: str | None, done: int):
        write(PROGRESS, {"startedAt": started, "current": current, "done": done, "total": len(images)})

    try:
        progress("database", 0)
        for flag in ("--download-db-only", "--download-java-db-only"):
            p = trivy("image", flag, "--quiet", timeout=1200)
            if p.returncode != 0:
                raise RuntimeError(f"Trivy database: {(p.stderr or p.stdout).strip().splitlines()[-1:]}")
        for n, (ref, containers) in enumerate(sorted(images.items())):
            progress(ref, n)
            entry = {"containers": sorted(containers), "critical": 0, "high": 0, "vulns": [], "error": None,
                     "scannedAt": time.time()}
            p = trivy("image", "--skip-db-update", "--skip-java-db-update", "--scanners", "vuln",
                      "--severity", "HIGH,CRITICAL", "--format", "json", "--quiet", "--timeout", "20m", ref)
            if p.returncode != 0:
                tail = (p.stderr or p.stdout).strip().splitlines()
                entry["error"] = (tail[-1] if tail else f"Trivy exited with {p.returncode}")[:300]
            else:
                seen = set()
                for res in (json.loads(p.stdout or "{}").get("Results") or []):
                    for v in res.get("Vulnerabilities") or []:
                        key = (v.get("VulnerabilityID"), v.get("PkgName"), v.get("InstalledVersion"))
                        if key in seen:
                            continue
                        seen.add(key)
                        sev = v.get("Severity")
                        entry["critical" if sev == "CRITICAL" else "high"] += 1
                        entry["vulns"].append({
                            "id": v.get("VulnerabilityID"), "pkg": v.get("PkgName"),
                            "installed": v.get("InstalledVersion"), "fixed": v.get("FixedVersion") or None,
                            "severity": sev, "title": (v.get("Title") or "")[:160] or None,
                            "url": v.get("PrimaryURL") or None, "target": res.get("Target"),
                        })
                entry["vulns"].sort(key=lambda v: (v["severity"] != "CRITICAL", not v["fixed"], v["pkg"] or ""))
                entry["vulns"] = entry["vulns"][:MAX_VULNS]
            result["images"][ref] = entry
        result["ok"] = all(not e["error"] for e in result["images"].values())
        if not result["ok"]:
            result["error"] = "Not every image could be scanned."
    except Exception as e:  # noqa: BLE001
        result["error"] = str(e)[:300]
        # Nothing got through (e.g. the database could not be loaded): keep the last results, show the error.
        if not result["images"]:
            try:
                prev = json.loads(OUT.read_text())
                result["images"], result["previousAt"] = prev.get("images") or {}, prev.get("finishedAt")
            except (OSError, ValueError):
                pass
    result["finishedAt"] = time.time()
    write(OUT, result)
    PROGRESS.unlink(missing_ok=True)
    print(f"keepwatch-image-scan: {len(result['images'])} images, "
          f"{sum(e['critical'] for e in result['images'].values())} critical, "
          f"{sum(e['high'] for e in result['images'].values())} high, error: {result['error']}")
    return 0 if result["ok"] else 1


if __name__ == "__main__":
    sys.exit(main())
