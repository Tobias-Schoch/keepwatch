#!/bin/sh
# Keepwatch SSH fallback: if SSH is closed to the internet (Tailscale only)
# and Tailscale on this server is not running, reopen the SSH port - after
# three failed checks in a row (timer every 5 minutes, so ~15 minutes).
# A broken or expired Tailscale can never lock you out this way; fail2ban
# protects the port as before.
COUNT=/run/keepwatch-ssh-fallback.count
ENV=/etc/keepwatch/firewall.env
SSH_PUBLIC=yes
# shellcheck disable=SC1090
[ -f "$ENV" ] && . "$ENV"
if [ "$SSH_PUBLIC" != no ]; then rm -f "$COUNT"; exit 0; fi

STATE=$(tailscale status --json 2>/dev/null | jq -r '.BackendState // "no status"' 2>/dev/null)
if [ "$STATE" = Running ] && tailscale ip -4 >/dev/null 2>&1; then rm -f "$COUNT"; exit 0; fi

N=$(( $(cat "$COUNT" 2>/dev/null || echo 0) + 1 ))
echo "$N" > "$COUNT"
logger -t keepwatch-ssh-fallback "Tailscale is not running (${STATE:-not installed}) - check $N of 3"
[ "$N" -ge 3 ] || exit 0

# The dashboard shows this marker as a red dot ("SSH was reopened").
printf 'SSH_PUBLIC=yes\n# SSH_FALLBACK_OPENED=%s Tailscale was not running (%s)\n' "$(date +%s)" "${STATE:-not installed}" > "$ENV"
systemctl restart keepwatch-firewall
rm -f "$COUNT"
logger -t keepwatch-ssh-fallback "SSH port reopened to the internet because Tailscale was not running (${STATE:-not installed})"
